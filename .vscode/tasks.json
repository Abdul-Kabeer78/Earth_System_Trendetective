{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev-server",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "tsx server.ts",
          "endsPattern": "listening on http://localhost"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "install-dependencies",
      "type": "npm",
      "script": "install",
      "detail": "Install Node.js packages"
    },
    {
      "label": "typecheck",
      "type": "npm",
      "script": "lint",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "build-production",
      "type": "npm",
      "script": "build",
      "group": "build"
    }
  ]
}
