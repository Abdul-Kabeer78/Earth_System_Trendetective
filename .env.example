# AI provider for Earth AI Detective and AI Environmental Impact Reports.
# Use ONE of the following providers:
# OPENROUTER_API_KEY="your_openrouter_key_here"
# OPENROUTER_MODEL="openai/gpt-4o-mini"
# OR:
# GEMINI_API_KEY="your_gemini_key_here"
# GEMINI_MODEL="gemini-2.5-flash"
# GOOGLE_API_KEY is also accepted as a fallback alias for Gemini.

# VITE_GOOGLE_MAPS_API_KEY: Required for the interactive Google Maps Earth view
# and location enrichments (Maps JS, Places, Geocoding, Elevation, Weather, Air Quality, Pollen, Solar, Time Zone).
VITE_GOOGLE_MAPS_API_KEY="your_google_maps_key_here"

# PORT: Optional local server port (defaults to 3000).
PORT="3000"

# APP_URL: Public URL of the app (defaults to http://localhost:3000 locally).
APP_URL="http://localhost:3000"

# DATABASE_URL: Optional PostgreSQL connection string for local persistence (watchlist, alerts, observations).
# If omitted locally in VS Code, the platform still runs all live telemetry, maps, and AI features seamlessly.
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/earth_detective"

# Optional external environmental API keys for enhanced feeds:
# NASA_FIRMS_MAP_KEY: Optional regional VIIRS 375m key (key-free MODIS C6.1 NRT stream is active by default)
NASA_FIRMS_MAP_KEY="your_nasa_firms_key_here"
# OPENWEATHER_API_KEY: Optional secondary weather cross-verification
OPENWEATHER_API_KEY="your_openweather_key_here"
# OPENAQ_API_KEY: Optional OpenAQ v3 ground sensor network key
OPENAQ_API_KEY="your_openaq_key_here"
